// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== MODELOS CRM =====

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  clients   Client[]
  projects  Project[]
}

model Client {
  id        String       @id @default(cuid())
  name      String
  email     String?
  company   String?
  status    ClientStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Ahora ownerId ES OPCIONAL (para no obligarnos a tener auth ya mismo)
  ownerId   String?
  owner     User?        @relation(fields: [ownerId], references: [id])

  projects  Project[]
  invoices  Invoice[]
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  LEAD
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ProjectStatus @default(IN_PROGRESS)
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?

  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])

  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id])

  tasks       Task[]
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Invoice {
  id        String        @id @default(cuid())
  amount    Float
  status    InvoiceStatus @default(PENDING)
  issuedAt  DateTime      @default(now())
  paidAt    DateTime?

  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}
